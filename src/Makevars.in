PKG_CFLAGS = @PKG_CFLAGS@
PKG_LIBS = @PKG_LIBS@

SOURCES = cursors.c document.c errors.c init.c memory.c objects.c sync.c
OBJECTS = $(SOURCES:.c=.o)

.PHONY: all tidy clean

all: tidy

tidy: $(SHLIB)
	@rm -rf automerge/rust/vendor ../am-build ../am-install

$(SHLIB): $(OBJECTS)

clean:
	rm -f $(OBJECTS) $(SHLIB)
